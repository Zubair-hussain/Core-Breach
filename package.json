{
  "name": "core-breach",
  "version": "1.0.0",
  "private": true,
  "description": "A free browser FPS built with three.js, GSAP and anime.js. Survive waves of rogue AI cores in a neon city.",
  "type": "module",
  "license": "MIT",
  "author": "Zubair Hussain (https://zubairhussain.xyz)",
  "homepage": "https://github.com/Zubair-hussain/Core-Breach#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zubair-hussain/Core-Breach.git"
  },
  "bugs": {
    "url": "https://github.com/Zubair-hussain/Core-Breach/issues"
  },
  "keywords": [
    "game",
    "fps",
    "browser-game",
    "threejs",
    "webgl",
    "gsap",
    "animejs",
    "web-audio"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-assets.mjs",
    "ci": "npm run lint && npm run format:check && npm test && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
